// Test String.drop() - frees the string's buffer and resets it to empty (Bug 108)

fn main() -> i32 {
    // Drop allocated string
    var s1: String = String.from("Drop me")
    if s1.len() != 7 {
        return 1
    }
    s1.drop()

    // After drop, the string is empty, not freed out from under the variable
    if s1.len() != 0 {
        return 2
    }
    if not s1.is_empty() {
        return 3
    }
    if s1.capacity() != 0 {
        return 4
    }

    // Can reallocate after drop
    s1.push('N')
    s1.push('e')
    s1.push('w')
    if s1.len() != 3 {
        return 5
    }
    if s1.as_str() != "New" {
        return 6
    }

    // Dropping twice is safe and leaves it empty
    s1.drop()
    s1.drop()
    if s1.len() != 0 {
        return 7
    }

    // Drop empty string (should be safe), then use it
    var s2: String = String.new()
    s2.drop()
    s2.push('o')
    s2.push('k')
    if s2.len() != 2 {
        return 8
    }

    print("All String.drop tests passed!")
    return 0
}
