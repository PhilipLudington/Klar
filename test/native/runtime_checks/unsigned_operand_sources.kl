// Bugs 74 and 75, qa-fix: an unsigned operand read through a field or an array
// element keeps its signedness. A u8 of 200 indexes element
// 200, divides by 3 to 66, and 128 / 255 is 0 with no false MIN / -1 trap.

struct Holder { b: u8 }

fn main() -> i32 {
    var big: [i32; 256] = @repeat(0, 256)
    big[200] = 42
    let h: Holder = Holder { b: 200.as#[u8] }
    if big[h.b] != 42 { return 1 }
    let ks: [u8; 1] = [200.as#[u8]]
    if big[ks[0]] != 42 { return 2 }

    var f: Holder = Holder { b: 200.as#[u8] }
    f.b /= 3.as#[u8]
    if f.b != 66.as#[u8] { return 3 }
    var g: Holder = Holder { b: 200.as#[u8] }
    g.b %= 3.as#[u8]
    if g.b != 2.as#[u8] { return 4 }

    var e: [u8; 2] = [200.as#[u8], 200.as#[u8]]
    e[0] /= 3.as#[u8]
    if e[0] != 66.as#[u8] { return 5 }
    e[1] %= 3.as#[u8]
    if e[1] != 2.as#[u8] { return 6 }

    let top: Holder = Holder { b: 128.as#[u8] }
    let all: u8 = 255.as#[u8]
    if top.b / all != 0.as#[u8] { return 9 }
    let tops: [u8; 1] = [128.as#[u8]]
    if tops[0] % all != 128.as#[u8] { return 10 }
    return 0
}
