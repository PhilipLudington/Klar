// Skip: native-tests
// Every runtime check's failure path, for the trap-lowering check in
// scripts/run-native-tests.sh (Bug 73). Compiled to LLVM IR only, never run.

enum Color { Red, Green }

struct Holder { items: List#[i32] }

fn make_arr() -> [i32; 3] {
    return [1, 2, 3]
}

fn make_slice() -> [i32] {
    let s: [i32] = [1, 2, 3]
    return s
}

fn make_list() -> List#[i32] {
    var l: List#[i32] = List.new#[i32]()
    l.push(1)
    return l
}

fn slice_read(s: [i32], i: i32) -> i32 {
    return s[i]
}

fn slice_write(s: [i32], i: i32) -> void {
    s[i] = 5
}

fn color_code(c: Color) -> i32 {
    var code: i32 = 0
    match c {
        Color::Red => { code = 1 }
        Color::Green => { code = 2 }
    }
    return code
}

fn main() -> i32 {
    var arr: [i32; 3] = [1, 2, 3]
    let i: i32 = 7
    arr[i] = 4
    let a: i32 = arr[i]
    let dv: [i32] = [1, 2, 3]
    let s: i32 = slice_read(dv, i)
    slice_write(dv, i)

    var list: List#[i32] = List.new#[i32]()
    list.push(1)
    let l: i32 = list[i]
    list[i] = 9
    list.set(i, 9)

    let big: i32 = 2147483647
    let sum: i32 = big + i

    let opt: ?i32 = None
    let f: i32 = opt!
    let r: Result#[i32, i32] = Err(3)
    let u: i32 = r.unwrap()
    let ok: Result#[i32, i32] = Ok(3)
    let e: i32 = ok.unwrap_err()
    let c: i32 = color_code(Color::Red)

    // Index paths other than a plain identifier (Debt 6).
    var h: Holder = Holder { items: List.new#[i32]() }
    let hf: i32 = h.items[i]
    let ma: i32 = make_arr()[i]
    let ms: i32 = make_slice()[i]
    let ml: i32 = make_list()[i]
    let fixed: [i32; 3] = [1, 2, 3]
    let ra: ref i32 = ref fixed[i]
    let rd: ref i32 = ref dv[i]

    // Division and remainder (Bug 75).
    let q: i32 = 10 / i
    let m: i32 = 10 % i
    return a + s + l + sum + f + u + e + c + hf + ma + ms + ml + q + m
}
