// Bug 84: a bare `None` under a contextual hint (a tuple element, a `push` argument) was
// emitted as `i32 0`, so a tuple holding it was built as `{i32, i32}` and read back with the
// optional's layout: the elements after it came back wrong.
fn main() -> i32 {
    let t: (?i64, i32) = (None, 3)
    if t.1 != 3 {
        return 1
    }
    if t.0 != None {
        return 2
    }

    var ts: List#[(?i64, i32)] = List.new#[(?i64, i32)]()
    ts.push((None, 4))
    let u: (?i64, i32) = ts.get(0)!
    if u.1 != 4 {
        return 3
    }
    if u.0 != None {
        return 4
    }

    var os: List#[?i64] = List.new#[?i64]()
    os.push(None)
    let back: ?i64 = os.get(0)!
    if back != None {
        return 5
    }
    return 0
}
