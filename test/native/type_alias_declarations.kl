// Bug 89, the declaration sites: a `var`, a method parameter and a string alias. Codegen
// read each declared type by its spelling, so a `var` of a u32 alias divided as signed, a
// method parameter of a struct alias lost its field names, and a local of a string alias
// was not a string (`len()` read 0). Each case returns its own exit code.
struct Point { x: i64, y: i64 }

type Q = Point

type Word = u32

type Name = string

struct Scaler { factor: i64 }

impl Scaler {
    fn scale_y(self: Scaler, q: Q) -> i64 {
        return q.y * self.factor
    }
}

fn main() -> i32 {
    // A `var` of an unsigned alias divides as unsigned.
    var w: Word = 3000000000
    w = w / 2.as#[u32]
    if w != 1500000000.as#[u32] {
        return 1
    }

    // A method parameter of a struct alias reads its fields by name.
    let s: Scaler = Scaler { factor: 2.as#[i64] }
    let q: Q = Point { x: 1.as#[i64], y: 2000000000.as#[i64] }
    if s.scale_y(q) != 4000000000.as#[i64] {
        return 2
    }

    // A local of a string alias is a string.
    let nm: Name = "abc"
    if nm.len() != 3 {
        return 3
    }

    return 0
}
