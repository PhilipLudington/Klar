// Bug 79: List.push emitted an integer literal at its default width (i32, or i64 above
// i32 max) instead of the element's width. A narrow literal left the rest of a wider slot
// as it was; a wide literal wrote past a narrower slot, and at a buffer's last slot past
// the allocation (the stdlib sha256 init_k heap corruption).
fn main() -> i32 {
    // Indexes are variables: a literal index under `let x: i64 =` hits a separate defect.
    let first: i32 = 0
    let second: i32 = 1
    let last: i32 = 7
    // An i32-range literal into an i64 slot that already holds all-ones bits.
    var wide: List#[i64] = List.new#[i64]()
    let ones: i64 = -1.as#[i64]
    wide.push(ones)
    let dropped: ?i64 = wide.pop()
    wide.push(7)
    let w0: i64 = wide.get(first)!
    if w0 != 7.as#[i64] {
        return 1
    }

    // A literal above i32 max into u32 lists. Every 32-byte buffer is allocated in list
    // order, even lists taking the literal and odd lists all-ones sentinels, so an 8-byte
    // store into an even list's last slot zeroes its neighbour's first slot.
    let n: i32 = 32
    let u32_ones: u32 = 4294967295
    var lists: List#[List#[u32]] = List.new#[List#[u32]]()
    var j: i32 = 0
    while j < n {
        lists.push(List.new#[u32]())
        j = j + 1
    }
    var r: i32 = 0
    while r < 8 {
        j = 0
        while j < n {
            var l: List#[u32] = lists.get(j)!
            if j % 2 == 0 {
                l.push(4000000000)
            } else {
                l.push(u32_ones)
            }
            j = j + 1
        }
        r = r + 1
    }
    let k: List#[u32] = lists.get(first)!
    let k7: u32 = k.get(last)!
    let k7_wide: i64 = k7.as#[i64]
    let big: i64 = 4000000000
    if k7_wide != big {
        return 2
    }
    j = 1
    while j < n {
        let s: List#[u32] = lists.get(j)!
        var i: i32 = 0
        while i < 8 {
            let v: u32 = s.get(i)!
            if v != u32_ones {
                return 4
            }
            i = i + 1
        }
        j = j + 2
    }

    // u8 elements keep their values.
    var b: List#[u8] = List.new#[u8]()
    b.push(200)
    b.push(1)
    let b0: u8 = b.get(first)!
    let b1: u8 = b.get(second)!
    if b0 != 200.as#[u8] or b1 != 1.as#[u8] {
        return 3
    }
    return 0
}
