// Skip: windows (pthread not available on MSVC)
// Bug 83: a Sender or Receiver that arrived as a function parameter, or was declared with
// `var`, was not recognised as a channel endpoint, so `send` emitted nothing and `recv` returned no channel value. Each
// send through a parameter is followed by one through a local, so a lost send reads the
// local's value instead of hanging.
fn produce(tx: Sender#[i64]) -> void {
    tx.send(4000000000)
}

fn consume(rx: Receiver#[i64]) -> i64 {
    let v: ?i64 = rx.recv()
    return v ?? 0.as#[i64]
}

fn finish(tx: Sender#[i64]) -> void {
    tx.close()
}

fn main() -> i32 {
    let pair: (Sender#[i64], Receiver#[i64]) = channel_create#[i64](8)
    let tx: Sender#[i64] = pair.0
    let rx: Receiver#[i64] = pair.1

    // Sender parameter, with a literal wider than i32 (the element type comes from the
    // parameter's declared type).
    produce(tx)
    tx.send(1)
    let big: i64 = 4000000000
    let a: ?i64 = rx.recv()
    if (a ?? 0.as#[i64]) != big {
        return 1
    }
    let one: ?i64 = rx.recv()
    if (one ?? 0.as#[i64]) != 1.as#[i64] {
        return 2
    }

    // Receiver parameter, read at the element's width: a value wider than i32 (Debt 13).
    tx.send(4000000000)
    if consume(rx) != big {
        return 3
    }

    // A `var` Receiver takes the same path as a parameter (Debt 13).
    var vrx: Receiver#[i64] = rx
    tx.send(4000000001)
    let vr: ?i64 = vrx.recv()
    if (vr ?? 0.as#[i64]) != 4000000001.as#[i64] {
        return 6
    }

    // A `var` Sender takes the same path as a parameter.
    var vtx: Sender#[i64] = tx
    vtx.send(6)
    tx.send(1)
    let six: ?i64 = rx.recv()
    if (six ?? 0.as#[i64]) != 6.as#[i64] {
        return 5
    }
    let one_more: ?i64 = rx.recv()

    // close through a Sender parameter: recv on the empty channel returns None.
    finish(tx)
    let closed: ?i64 = rx.recv()
    if closed != None {
        return 4
    }

    // A bare `None` sent on a `Sender#[?i64]` is the optional's none value (Debt 13).
    let opair: (Sender#[?i64], Receiver#[?i64]) = channel_create#[?i64](4)
    let otx: Sender#[?i64] = opair.0
    let orx: Receiver#[?i64] = opair.1
    otx.send(None)
    otx.send(Some(7.as#[i64]))
    let first: ? ?i64 = orx.recv()
    let first_inner: ?i64 = first ?? Some(99.as#[i64])
    if first_inner != None {
        return 7
    }
    let second: ? ?i64 = orx.recv()
    let second_inner: ?i64 = second ?? Some(0.as#[i64])
    if (second_inner ?? 0.as#[i64]) != 7.as#[i64] {
        return 8
    }
    return 0
}
