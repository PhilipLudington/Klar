// `.to_string()` on a `string` makes a `String` every backend can use (Bug 118)
// assert_eq, not `return N`: --vm and --interpret discard main's return (Bug 50)

fn main() -> i32 {
    // Receiver is a literal
    let s: String = "abc".to_string()
    assert_eq(s.len(), 3)

    // Receiver is a `string` binding
    let a: string = "hello"
    let t: String = a.to_string()
    assert_eq(t.len(), 5)

    // The source string is still usable afterwards
    assert_eq(a.len(), 5)

    // Empty receiver
    let e: String = "".to_string()
    assert_eq(e.len(), 0)
    return 0
}
